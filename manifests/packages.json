{
  "schemaVersion": 1,
  "pi": {
    "package": "@earendil-works/pi-coding-agent",
    "version": "1.6.0",
    "compatible": "1.6.0"
  },
  "packages": [
    {
      "name": "pi-agnes-tools",
      "version": "0.3.7",
      "pin": "npm:pi-agnes-tools@0.3.7",
      "source": "npm:pi-agnes-tools"
    },
    {
      "name": "pi-ollama-cloud",
      "version": "0.13.1",
      "pin": "npm:pi-ollama-cloud@0.13.1",
      "source": "npm:pi-ollama-cloud"
    },
    {
      "name": "pi-better-edit",
      "version": "2.21.0",
      "pin": "npm:pi-better-edit@2.21.0",
      "source": "npm:pi-better-edit"
    }
  ],
  "excluded": [
    "pi-profile-switch（Windows 相容性問題，已改用 extensions/mode-switch.ts，不安裝）"
  ],
  "lsp": {
    "installDir": "agent/lsp",
    "packages": [
      {
        "name": "typescript",
        "version": "5.9.3"
      },
      {
        "name": "typescript-language-server",
        "version": "6.1.0"
      }
    ],
    "installCommand": "npm install --prefix \"$env:USERPROFILE/.pi/agent/lsp\" --ignore-scripts --save-exact --no-audit --no-fund typescript@5.9.3 typescript-language-server@6.1.0",
    "csharp": {
      "server": "Microsoft.CodeAnalysis.LanguageServer from the Microsoft C# VS Code extension (ms-dotnettools.csharp), Authenticode-signed",
      "discovery": "~/.vscode/extensions/ms-dotnettools.csharp-*/.roslyn or ASTRA_ROSLYN_LS",
      "testedWith": "ms-dotnettools.csharp 2.160.4, .NET SDK 10.0.401"
    }
  }
}
